{
  "accepted_extensions": [
    ".json",
    ".yaml",
    ".yml",
    ".xml",
    ".txt",
    ".pdf",
    ".docx"
  ],
  "parsers": {
    ".json": "structured",
    ".yaml": "structured",
    ".yml": "structured",
    ".xml": "xml",
    ".txt": "text",
    ".pdf": "text",
    ".docx": "text"
  },
  "classification": {
    "rules": [
      {
        "name": "api_specification",
        "signals": [
          "openapi",
          "swagger",
          "paths",
          "components",
          "securityDefinitions",
          "servers"
        ]
      },
      {
        "name": "test_knowledge",
        "signals": [
          "test",
          "test_case",
          "expected_status",
          "assertions",
          "boundary",
          "security"
        ]
      },
      {
        "name": "backend_document",
        "signals": [
          "endpoint",
          "request",
          "response",
          "schema",
          "parameter"
        ]
      }
    ],
    "default": "backend_document",
    "api_document_classification": "api_specification"
  },
  "chunking": {
    "strategy": "structure_aware",
    "max_characters": 1800,
    "overlap_characters": 200,
    "preserve_parent_context": true
  },
  "embedding": {
    "provider": "sentence_transformers",
    "model": "BAAI/bge-small-en-v1.5",
    "normalize": true
  },
  "common_document_model": {
    "fields": [
      "document_id",
      "document_type",
      "service_name",
      "service_description",
      "version",
      "base_url",
