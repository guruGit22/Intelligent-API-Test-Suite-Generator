      "query_parameters",
      "header_parameters",
      "request_body",
      "request_schema",
      "response_schema",
      "response_status",
      "authentication",
      "required_fields",
      "optional_fields",
      "data_type",
      "default_value",
      "allowed_values",
      "example_values",
      "constraints",
      "dependencies",
      "relationships",
      "business_rules"
    ],
    "mapping_aliases": {
