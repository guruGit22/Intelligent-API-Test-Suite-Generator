# --- OpenAI ---
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini

# --- FAISS / embeddings ---
FAISS_INDEX_PATH=data/knowledge_base/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Knowledge base data files ---
KNOWLEDGE_BASE_DIR=data/knowledge_base
TEST_PATTERNS_FILE=data/knowledge_base/test_patterns.json
SECURITY_RULES_FILE=data/knowledge_base/security_rules.json
BOUNDARY_VALUES_FILE=data/knowledge_base/boundary_values.json
HISTORICAL_FEEDBACK_FILE=data/knowledge_base/historical_feedback.json

# --- Generated artifacts ---
GENERATED_TESTS_DIR=tests/generated_tests
GENERATED_POSTMAN_DIR=artifacts/generated_postman

# --- Storage (local JSON) ---
STORAGE_DIR=src/storage/data

# --- Reports ---
REPORTS_DIR=artifacts/reports/output

# --- Logging ---
LOGS_DIR=artifacts/logs
LOG_LEVEL=INFO

# --- External tools ---
NEWMAN_EXECUTABLE=newman

# MongoDB (required for the new document ingestion/understanding flow)
MONGO_URI=
MONGO_DATABASE=api_test_generator
MONGO_DOCUMENT_COLLECTION=documents
MONGO_CHUNK_COLLECTION=document_chunks

# Ingestion / embeddings
INGESTION_CONFIG_FILE=config/ingestion_config.json
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Document retention & archival (Data Ingestion originals)
DOCUMENT_RETENTION_ENABLED=true
DOCUMENT_RETENTION_MINUTES=15
DOCUMENT_ARCHIVE_ACTIVE_DIR=artifacts/archive/active
DOCUMENT_ARCHIVE_COMPRESSED_DIR=artifacts/archive/compressed
DOCUMENT_ARCHIVE_CLEANUP_INTERVAL_SECONDS=60
